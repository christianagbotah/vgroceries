[Unit]
Description=Variety Groceries isolated cashier POS staging API
Requires=vg-pos-staging-postgres.service
After=vg-pos-staging-postgres.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=exec
User=lightworld
Group=lightworld
WorkingDirectory=/home/lightworld/workspaces/vgroceries-pos-integrated-20261110/apps/api
EnvironmentFile=/home/lightworld/workspaces/vgroceries-pos-integrated-20261110/apps/api/.env
ExecStart=/home/lightworld/runtime/node24/bin/node dist/src/main.js
Restart=always
RestartSec=4s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
