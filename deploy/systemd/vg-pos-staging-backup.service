[Unit]
Description=Back up isolated Variety Groceries POS staging database
Requires=vg-pos-staging-postgres.service
After=vg-pos-staging-postgres.service

[Service]
Type=oneshot
User=lightworld
Group=lightworld
ExecStart=/home/lightworld/workspaces/vgroceries-pos-staging-pg-20261110/scripts/backup-staging.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/lightworld/workspaces/vgroceries-pos-staging-pg-20261110/backups
