NODE_ENV=development
DATABASE_URL=postgresql://variety:replace_me@127.0.0.1:5432/variety
WEB_ORIGINS=http://localhost:3000
API_STOCK_LOCATION_ID=loc_accra
API_HOST=127.0.0.1
PORT=3010
# Local HTTP only; rejected when NODE_ENV=production.
API_INSECURE_COOKIES=true

# Product media (UAT filesystem example; production launch uses s3)
PRODUCT_MEDIA_STORAGE=filesystem
PRODUCT_MEDIA_FILESYSTEM_ROOT=/home/lightworld/data/varietygroceries/product-media
PRODUCT_MEDIA_PUBLIC_BASE_URL=https://portal.varietygroceries.com/media/products/
# PRODUCT_MEDIA_STORAGE=s3
# PRODUCT_MEDIA_S3_ENDPOINT=https://s3.example.com
# PRODUCT_MEDIA_S3_REGION=auto
# PRODUCT_MEDIA_S3_BUCKET=variety-products
# PRODUCT_MEDIA_S3_ACCESS_KEY_ID=replace_me
# PRODUCT_MEDIA_S3_SECRET_ACCESS_KEY=replace_me

# UAT begins with deterministic fake generation. Switch to OpenAI only after fake-provider UAT passes.
AI_IMAGE_PROVIDER=fake
AI_IMAGE_MODEL=fake-image-v1
# AI_IMAGE_PROVIDER=openai
# AI_IMAGE_MODEL=gpt-image-2
# OPENAI_API_KEY=replace_me
AI_IMAGE_TIMEOUT_MS=60000
AI_IMAGE_MAX_CANDIDATES=4
AI_IMAGE_WORKER_POLL_MS=2000

# Legacy image migration. External URLs are skipped; draft review is the safe default.
LEGACY_PRODUCT_MEDIA_ROOT=/home/lightworld/webapps/varietygroceries-api/current/public
LEGACY_PRODUCT_MEDIA_REVIEW_POLICY=draft
LEGACY_PRODUCT_MEDIA_ACTOR_ID=legacy-media-import

# Electronic payments (disabled unless the complete provider bundle is supplied).
# PAYMENT_PROVIDER_ID=hubtel
# PAYMENT_ENABLED_METHODS=mobile_money
# PAYMENT_CONFIRMED_HOLD_MINUTES=1440
# PAYMENT_PROVIDER_TIMEOUT_MS=5000
# PAYMENT_RECONCILE_AFTER_SECONDS=120
# PAYMENT_HOSTED_DOMAINS=pay.hubtel.com
# Hubtel Request Money adapter. Keep these server-only and use only URLs confirmed for your merchant account.
# HUBTEL_CLIENT_ID=replace_with_hubtel_client_id
# HUBTEL_CLIENT_SECRET=replace_with_hubtel_client_secret
# HUBTEL_REQUEST_MONEY_URL=https://replace-with-verified-hubtel-api/request-money/{mobileNumber}
# HUBTEL_STATUS_URL=https://replace-with-verified-hubtel-status/{reference}
# HUBTEL_CALLBACK_URL=https://portal.varietygroceries.com/api/v1/payments/providers/hubtel/events
# HUBTEL_RETURN_URL=https://portal.varietygroceries.com/checkout/payment-return
# HUBTEL_CANCELLATION_URL=https://portal.varietygroceries.com/checkout/payment-return?cancelled=1

# Hubtel refund adapter (disabled unless this entire server-only bundle is supplied).
# Use only the current Hubtel refund endpoint/base URL confirmed for your merchant account.
# HUBTEL_REFUND_BASE_URL=https://verified-hubtel-refund-api.example
# HUBTEL_REFUND_BASIC_USERNAME=replace_with_hubtel_api_username
# HUBTEL_REFUND_BASIC_PASSWORD=replace_with_hubtel_api_password
# HUBTEL_REFUND_COLLECTION_ACCOUNT=replace_with_numeric_collection_account
# HUBTEL_REFUND_CALLBACK_ORIGIN=https://portal.varietygroceries.com
# Generate a private 32-128 character URL-safe secret; never expose it to browser code.
# HUBTEL_REFUND_CALLBACK_SECRET=replace_with_private_callback_secret
