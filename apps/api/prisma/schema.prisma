generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  inventory_manager
  cashier
  customer
  rider
}

model User {
  id String @id @default(uuid())
  email String? @unique
  name String
  phone String @default("")
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
  passwordResets PasswordResetToken[]
  staffInvitation StaffInvitation?
  locations UserLocation[]
  customerAddresses CustomerAddress[]
  orders Order[]
  customerReturnClaims CustomerReturnClaim[]
  notifications Notification[]
  riderProfile RiderProfile?
  codDeclarations CodCashDeclaration[] @relation("CodDeclarationActor")
  codSupervisorCounts CodSupervisorCount[] @relation("CodSupervisorCountActor")
  pickupAttendanceRecords PickupAttendanceRecord[]
  posCustomerSales PosCashSale[] @relation("PosSaleRegisteredCustomer")
  // Existing UAT database relationships; no database change.
  CashierTillSession_CashierTillSession_closedByUserIdToUser CashierTillSession[]     @relation("CashierTillSession_closedByUserIdToUser")
  CashierTillSession_CashierTillSession_openedByUserIdToUser CashierTillSession[]     @relation("CashierTillSession_openedByUserIdToUser")
  PosCashSale_PosCashSale_soldByUserIdToUser                 PosCashSale[]            @relation("PosCashSale_soldByUserIdToUser")
  cashierTillMovements                                       CashierTillMovement[]
  posStockHolds                                              PosStockHold[]
}

// Raw recovery secrets are NEVER persisted. A token can be used only once.
model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  channel String
  tokenHash String? @unique
  csrfHash String?
  accessHash String? @unique
  accessExpiresAt DateTime? @db.Timestamptz(3)
  currentRefreshHash String? @unique
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  refreshHistory RefreshToken[]
  @@index([userId, expiresAt])
}

// One invitation per cashier. The raw code never enters PostgreSQL and
// only a single successful acceptance can move a cashier into active status.
model StaffInvitation {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdByUserId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}

model RefreshToken {
  hash String @id
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  usedAt DateTime? @db.Timestamptz(3)
}

model LoginThrottle {
  key String @id
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
}

model Location {
  id String @id
  name String
  active Boolean @default(true)
  grants UserLocation[]
  inboundTransferRequests InternalTransferRequest[] @relation("TransferDestination")
  outboundTransferRequests InternalTransferRequest[] @relation("TransferSource")
  positions StockPosition[]
  physicalReturnReceipts PhysicalReturnReceipt[]
  logisticsNode LogisticsNode?
  // Existing UAT database relationships; no database change.
  cashierTillSessions    CashierTillSession[]
  posStockHolds          PosStockHold[]
  posCashSales           PosCashSale[]
}

model UserLocation {
  userId String
  user User @relation(fields: [userId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  @@id([userId, locationId])
}

model Category {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String @default("")
  tint String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  products Product[]
}

model Product {
  id String @id @default(uuid())
  slug String @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  description String @default("")
  shortDescription String @default("")
  image String @default("")
  tags String[]
  published Boolean @default(false)
  brandMode String @default("auto")
  featuredMediaId String? @unique
  featuredMedia ProductMedia? @relation("ProductFeaturedMedia", fields: [featuredMediaId], references: [id])
  media ProductMedia[] @relation("ProductMediaCollection")
  generationJobs ImageGenerationJob[] @relation("ProductGenerationJobs")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  variants Variant[]
  @@index([categoryId, published])
}

model ProductMedia {
  id String @id @default(uuid())
  productId String
  product Product @relation("ProductMediaCollection", fields: [productId], references: [id])
  source String
  status String @default("draft")
  storageKey String @unique
  publicUrl String?
  mimeType String
  width Int
  height Int
  byteSize Int
  sha256 String
  altText String @default("")
  galleryOrder Int?
  originalFilename String?
  generationJobId String?
  generationJob ImageGenerationJob? @relation("GenerationCandidates", fields: [generationJobId], references: [id])
  referenceForJobs ImageGenerationJob[] @relation("GenerationReferenceMedia")
  createdBy String
  approvedBy String?
  approvedAt DateTime? @db.Timestamptz(3)
  rejectedAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  featuredFor Product? @relation("ProductFeaturedMedia")
  @@index([productId, status, galleryOrder])
  @@index([generationJobId])
  @@index([sha256])
}

model ImageGenerationJob {
  id String @id @default(uuid())
  productId String
  product Product @relation("ProductGenerationJobs", fields: [productId], references: [id])
  requestedBy String
  mode String
  stylePreset String
  status String @default("queued")
  provider String
  model String
  prompt String
  requestSnapshot Json
  referenceMediaId String?
  referenceMedia ProductMedia? @relation("GenerationReferenceMedia", fields: [referenceMediaId], references: [id], onDelete: Restrict)
  candidateCount Int
  providerRequestId String?
  attemptCount Int @default(0)
  errorCode String?
  errorMessage String?
  startedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  candidates ProductMedia[] @relation("GenerationCandidates")
  @@index([productId, createdAt])
  @@index([status, createdAt])
}

model Variant {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  name String
  unit String
  unitSize String @default("1")
  priceMinor Int
  compareAtPriceMinor Int?
  barcode String? @unique
  active Boolean @default(true)
  positions StockPosition[]
  @@index([productId, active])
  // Existing UAT database relationships; no database change.
  posStockHoldLines   PosStockHoldLine[]
  posCashReceiptLines PosCashReceiptLine[]
  transferRequestLines InternalTransferRequestLine[]
}

model StockPosition {
  id String @id @default(uuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  safetyStock Decimal @default(0) @db.Decimal(15, 3)
  lots StockLot[]
  reservations Reservation[]
  @@unique([variantId, locationId])
}

model StockLot {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  receiptId String?
  receipt StockReceipt? @relation(fields: [receiptId], references: [id])
  lotNumber String
  quantity Decimal @db.Decimal(15, 3)
  expiryDate DateTime? @db.Date
  quarantined Boolean @default(false)
  kind String @default("regular")
  unitCostMinor Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  movements StockMovement[]
  adjustments StockAdjustment[]
  reservations Reservation[]
  fulfilmentPicks FulfilmentPick[]
  depletionLines StockDepletionLine[]
  originalPhysicalReturnCustodies PhysicalReturnCustody[] @relation("PhysicalReturnOriginalLot")
  quarantinedPhysicalReturnCustody PhysicalReturnCustody? @relation("PhysicalReturnQuarantineLot")
  physicalReturnResaleReview PhysicalReturnResaleReview?
  @@unique([id, positionId])
  @@index([positionId, kind, quarantined, expiryDate])
}

model StockAdjustment {
  id String @id @default(uuid())
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  variantId String
  locationId String
  delta Decimal @db.Decimal(15, 3)
  reason String
  note String?
  status String @default("pending_approval")
  requestedBy String
  decidedBy String?
  beforeQuantity Decimal @db.Decimal(15, 3)
  afterQuantity Decimal? @db.Decimal(15, 3)
  movementReceiptId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  decidedAt DateTime? @db.Timestamptz(3)
  @@index([locationId, status, createdAt])
  @@index([lotId, createdAt])
}

model Reservation {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  lotId String
  lot StockLot @relation(fields: [lotId, positionId], references: [id, positionId])
  claimType String
  claimId String
  claimLineId String
  generation Int @default(1)
  quantity Decimal @db.Decimal(15, 3)
  state String @default("active")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  fulfilmentPick FulfilmentPick?
  depletionLine StockDepletionLine?
  @@unique([claimType, claimId, claimLineId, lotId, generation])
  @@index([positionId, state, expiresAt])
  @@index([lotId, state, expiresAt])
  @@index([claimType, claimId, state])
}

model StockReceipt {
  id String @id @default(uuid())
  receivedBy String
  note String?
  poRef String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lots StockLot[]
  movements StockMovement[]
  physicalReturnCustodies PhysicalReturnCustody[]
  physicalReturnResaleReviews PhysicalReturnResaleReview[]
}

model StockMovement {
  id String @id @default(uuid())
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  receiptId String
  receipt StockReceipt @relation(fields: [receiptId], references: [id])
  delta Decimal @db.Decimal(15, 3)
  resultingQty Decimal @db.Decimal(15, 3)
  actorId String
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([lotId, createdAt])
}

model Idempotency {
  actorId String
  operation String
  key String
  requestHash String
  outcome Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorId, operation, key])
}

model CmsContent {
  key String @id
  kind String
  draft Json
  published Json
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  @@index([kind])
}

model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  entityId String
  requestId String
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([entityId, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid())
  type String
  aggregateId String
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  notificationReceipt NotificationOutboxReceipt?
  notification Notification?
  @@index([publishedAt, createdAt])
}

model Notification {
  id String @id @default(uuid())
  recipientUserId String
  recipientUser User @relation(fields: [recipientUserId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  sourceEventId String @unique
  sourceEvent OutboxEvent @relation(fields: [sourceEventId], references: [id])
  kind String
  title String
  body String
  readAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([recipientUserId, createdAt, id])
}

/// Provider-neutral, consent-gated external delivery queue. Never a payment authority.
/// A worker must validate customer consent and event evidence before dispatch.
model CustomerMessageDelivery {
  id String @id @default(uuid())
  sourceEventId String
  channel String // sms | email | whatsapp
  recipientFingerprint String // hashed normalized address; never raw PII in queue keys
  recipientEncrypted String // envelope-encrypted destination, not plaintext
  templateKey String
  templateVersion Int @default(1)
  status String @default("pending") // pending | sending | delivered | failed | suppressed
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  providerMessageId String?
  lastErrorCode String?
  consentRecordedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  @@unique([sourceEventId, channel, recipientFingerprint])
  @@index([status, nextAttemptAt])
}

model NotificationOutboxReceipt {
  sourceEventId String @id
  sourceEvent OutboxEvent @relation(fields: [sourceEventId], references: [id])
  outcome String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}

model GuestCheckoutSession {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfHash String
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  orders Order[]
  @@index([expiresAt, revokedAt])
}

model CustomerAddress {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  label String
  recipientName String
  phone String
  locality String
  street String
  landmark String?
  ghanaPostGps String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  @@index([userId, isDefault])
}

model DeliveryZone {
  id String @id
  name String
  areas String[]
  active Boolean @default(true)
  feeMinor Int
  minimumOrderMinor Int
  serviceHours String
  cutoff String
  slotsPerDay Int
  slotPolicy String @default("required")
  codEnabled Boolean @default(false)
  slots DeliverySlot[]
  orders Order[]
  routeRules DeliveryRouteRule[]
  @@index([active, name])
}

model DeliverySlot {
  id String @id
  zoneId String
  zone DeliveryZone @relation(fields: [zoneId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  capacity Int
  active Boolean @default(true)
  bookings DeliverySlotBooking[]
  orders Order[]
  @@index([zoneId, active, startsAt])
}

model Order {
  id String @id @default(uuid())
  reference String @unique
  channel String @default("online")
  customerUserId String?
  customerUser User? @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  guestSessionId String?
  guestSession GuestCheckoutSession? @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  customerName String
  customerPhone String
  customerEmail String?
  fulfilment String
  zoneId String?
  zone DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  slotId String?
  slot DeliverySlot? @relation(fields: [slotId], references: [id], onDelete: Restrict)
  paymentMethod String
  paymentStatus String
  fulfilmentStatus String
  deliveryStatus String
  subtotalMinor Int
  discountMinor Int @default(0)
  deliveryFeeMinor Int @default(0)
  totalMinor Int
  verificationKeyVersion Int
  verificationCodeHash String
  version Int @default(1)
  note String?
  stockConsumedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelledReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  lines OrderLine[]
  events OrderEvent[]
  deliveryAddress OrderDeliveryAddress?
  pickupSnapshot OrderPickupSnapshot?
  pickupAppointment PickupAppointment?
  pickupAttendanceRecords PickupAttendanceRecord[]
  slotBooking DeliverySlotBooking?
  paymentAttempts PaymentAttempt[]
  refunds Refund[]
  fulfilmentRun FulfilmentRun?
  deliveryJob DeliveryJob?
  codCashDeclaration CodCashDeclaration?
  deliveryEvents DeliveryEvent[]
  shipments Shipment[]
  collectionReceipts ShipmentCollectionReceipt[]
  physicalReturnReceipts PhysicalReturnReceipt[]
  customerReturnClaims CustomerReturnClaim[]
  notifications Notification[]
  smsConsent OrderSmsConsent?
  @@index([customerUserId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([zoneId, createdAt])
  @@index([slotId, createdAt])
}

/// An explicit order-scoped preference, bound to the checkout contact snapshot.
/// No historical backfill; revocation and delivery authorization are separate.
model OrderSmsConsent {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recipientFingerprint String
  policyVersion String
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
}

/// Staff-verified physical possession of returned customer goods; never a
/// stock increment or a payment/refund obligation. One receipt may cover
/// several order lines. Disposition is a separate, guarded inspection step.
/// R3a customer-submitted return request, not physically received stock
/// and not a refund authorization. No orders, lots or money are mutated.
model CustomerReturnClaim {
  id String @id @default(uuid())
  reference String @unique
  orderId String
  order Order @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  customerUserId String
  customer User @relation(fields: [customerUserId], references: [id], onUpdate: NoAction)
  status String @default("requested") // requested | accepted | rejected | cancelled
  reason String
  evidenceNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewedBy String?
  reviewNote String?
  cancelledAt DateTime? @db.Timestamptz(3)
  lines CustomerReturnClaimLine[]
  physicalReceipts PhysicalReturnReceipt[]
  @@index([customerUserId, createdAt], map: "customer_claim_customer_date")
  @@index([orderId, status], map: "customer_claim_order_status")
  @@index([status, createdAt], map: "customer_claim_status_date")
}

model CustomerReturnClaimLine {
  claimId String
  claim CustomerReturnClaim @relation(fields: [claimId], references: [id], onUpdate: NoAction)
  orderLineId String
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onUpdate: NoAction)
  quantity Decimal @db.Decimal(15, 3)
  reason String
  @@id([claimId, orderLineId])
  @@index([orderLineId], map: "customer_return_claim_line_original")
}

model PhysicalReturnReceipt {
  id String @id @default(uuid())
  reference String @unique
  orderId String
  order Order @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  locationId String
  location Location @relation(fields: [locationId], references: [id], onUpdate: NoAction)
  status String @default("received") // received | inspected
  reason String
  evidenceNote String
  receivedBy String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  inspectedBy String?
  inspectedAt DateTime? @db.Timestamptz(3)
  inspectionSummary String?
  items PhysicalReturnItem[]
  customerClaimId String?
  customerClaim CustomerReturnClaim? @relation(fields: [customerClaimId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([customerClaimId, receivedAt], map: "PhysicalReturnReceipt_claim_date_idx")
  @@index([orderId, receivedAt], map: "PhysicalReturnReceipt_order_date_idx")
  @@index([locationId, receivedAt], map: "PhysicalReturnReceipt_location_date_idx")
}

model PhysicalReturnItem {
  id String @id @default(uuid())
  receiptId String
  receipt PhysicalReturnReceipt @relation(fields: [receiptId], references: [id], onUpdate: NoAction)
  orderLineId String
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onUpdate: NoAction)
  variantId String
  quantity Decimal @db.Decimal(15, 3)
  condition String // sealed | opened | damaged | unknown
  disposition String @default("awaiting_inspection") // quarantine | destroy
  inspectionNote String?
  inspectedBy String?
  inspectedAt DateTime? @db.Timestamptz(3)
  custody PhysicalReturnCustody?
  resaleReview PhysicalReturnResaleReview?
  @@unique([receiptId, orderLineId], map: "PhysicalReturnItem_receipt_line_key")
  @@index([orderLineId, disposition], map: "PhysicalReturnItem_line_status_idx")
}

/// An immutable, exactly-once transfer into NON-SELLABLE quarantine inventory.
/// No automatic refund or saleable restocking can originate from this record.
model PhysicalReturnCustody {
  itemId String @id
  item PhysicalReturnItem @relation(fields: [itemId], references: [id], onUpdate: NoAction)
  sourceLotId String
  sourceLot StockLot @relation("PhysicalReturnOriginalLot", fields: [sourceLotId], references: [id], onUpdate: NoAction)
  quarantineLotId String @unique
  quarantineLot StockLot @relation("PhysicalReturnQuarantineLot", fields: [quarantineLotId], references: [id], onUpdate: NoAction)
  stockReceiptId String
  stockReceipt StockReceipt @relation(fields: [stockReceiptId], references: [id], onUpdate: NoAction)
  quantity Decimal @db.Decimal(15, 3)
  custodyNote String
  recordedBy String
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([stockReceiptId])
}

/// R2b two-person food-safety gate: no resale without independently
/// reviewed custody, original lot expiry, non-food policy and stock transfer.
model PhysicalReturnResaleReview {
  itemId String @id
  item PhysicalReturnItem @relation(fields: [itemId], references: [id], onUpdate: NoAction)
  status String @default("pending") // pending | approved | rejected
  evidenceNote String
  safetyClassification String
  factorySealIntact Boolean
  tamperAndContaminationAbsent Boolean
  sourceTraceabilityVerified Boolean
  expiryAndStorageVerified Boolean
  proposedBy String
  proposedAt DateTime @default(now()) @db.Timestamptz(3)
  decidedBy String?
  decidedAt DateTime? @db.Timestamptz(3)
  decisionNote String?
  saleableLotId String? @unique
  saleableLot StockLot? @relation(fields: [saleableLotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transferReceiptId String?
  transferReceipt StockReceipt? @relation(fields: [transferReceiptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([status, proposedAt])
}

model PickupAppointmentPolicy {
  nodeId String @id
  node LogisticsNode @relation(fields: [nodeId], references: [id], onUpdate: NoAction)
  active Boolean @default(false)
  serviceDays Int[]
  opensAt String
  closesAt String
  slotMinutes Int
  capacity Int
  minLeadMinutes Int
  maxDaysAhead Int
  updatedBy String
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
}

/// Explicit centre-specific local-calendar closure. An active closure must
/// never silently displace an already booked collection appointment.
model PickupCentreClosure {
  nodeId String
  node LogisticsNode @relation(fields: [nodeId], references: [id], onUpdate: NoAction)
  date DateTime @db.Date
  closed Boolean @default(true)
  reason String?
  updatedBy String
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  @@id([nodeId, date])
  @@index([date, closed])
}

model PickupAppointment {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  nodeId String
  node LogisticsNode @relation(fields: [nodeId], references: [id], onUpdate: NoAction)
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status String // booked | cancelled | completed
  bookedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
