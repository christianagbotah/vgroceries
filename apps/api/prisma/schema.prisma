  position           Int
  originStopId       String
  originStop         ShipmentStop    @relation("ShipmentLegOriginStop", fields: [originStopId], references: [id])
  destinationStopId  String
  destinationStop    ShipmentStop    @relation("ShipmentLegDestinationStop", fields: [destinationStopId], references: [id])
  laneId             String
  lane               LogisticsLane   @relation(fields: [laneId], references: [id])
  mode               String
  providerKey        String?
  typicalMinutes     Int
  status             String          @default("planned")
  departedAt         DateTime?       @db.Timestamptz(3)
  arrivedAt          DateTime?       @db.Timestamptz(3)
  slaDeadline        DateTime?       @db.Timestamptz(3)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  events             ShipmentEvent[]
  currentForShipment Shipment?       @relation("ShipmentCurrentLeg")

  @@unique([shipmentId, routeRevision, position])
  @@index([originStopId])
  @@index([destinationStopId])
  @@index([laneId])
  @@index([status, updatedAt])
}

model ShipmentEvent {
  id             String         @id @default(uuid())
  shipmentId     String
  shipment       Shipment       @relation(fields: [shipmentId], references: [id])
  routeRevision  Int
  legId          String?
  leg            ShipmentLeg?   @relation(fields: [legId], references: [id], onDelete: Restrict)
  nodeId         String?
  node           LogisticsNode? @relation("ShipmentEventNode", fields: [nodeId], references: [id], onDelete: Restrict)
  eventKind      String
  actorKind      String
  actorId        String?
  fromCustody    String?
  toCustody      String?
  customerTitle  String?
  customerDetail String?
  safeMetadata   Json
  requestId      String
  occurredAt     DateTime       @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  collectionReceipt ShipmentCollectionReceipt?

  @@index([shipmentId, occurredAt, id])
  @@index([legId, occurredAt])
  @@index([nodeId, occurredAt])
  @@index([requestId])
}


// Private, append-only proof for verified customer collection at a remote pickup centre.
// The human's name and identity attestation MUST NOT be surfaced through PublicOrder.
model ShipmentCollectionReceipt {
  id String @id @default(uuid())
  shipmentId String @unique
  shipment Shipment @relation(fields: [shipmentId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  nodeId String
  node LogisticsNode @relation(fields: [nodeId], references: [id])
  eventId String @unique
  event ShipmentEvent @relation(fields: [eventId], references: [id])
  staffActorId String
  receiverName String
  identityCheck String
  verificationKeyVersion Int
  collectedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, collectedAt])
  @@index([staffActorId, collectedAt])
}

/**
 * POS P0a: cash drawer evidence only. This is not yet an order/payment ledger.
 * Until unified POS sale authority is enabled, no sale proceeds may be inferred
 * from these records or reported as a final business cash reconciliation.
 */
model CashierTillSession {
  id String @id @default(uuid())
  locationId String
  tillCode String
  openedByUserId String
  status String @default("open")
  openingFloatMinor Int
  openedAt DateTime @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  closedByUserId String?
  closingCountedMinor Int?
  closingExpectedMinor Int?
  closingDifferenceMinor Int?
  closeNote String?
  movements CashierTillMovement[]
  stockHolds PosStockHold[]
  cashSales PosCashSale[]
  @@index([locationId, status, openedAt], map: "cashier_till_location_status")
  @@index([openedByUserId, openedAt], map: "cashier_till_opened_by")
  // Existing UAT database relationships; no database change.
  User_CashierTillSession_closedByUserIdToUser User?                 @relation("CashierTillSession_closedByUserIdToUser", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  Location                                     Location              @relation(fields: [locationId], references: [id], onUpdate: NoAction)
  User_CashierTillSession_openedByUserIdToUser User                  @relation("CashierTillSession_openedByUserIdToUser", fields: [openedByUserId], references: [id], onUpdate: NoAction)
}

model CashierTillMovement {
  id String @id @default(uuid())
  sessionId String
  session CashierTillSession @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  kind String
  amountMinor Int
  note String
  actorUserId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([sessionId, createdAt], map: "cashier_till_movement_session_date")
  // Existing UAT database relationships; no database change.
  User        User               @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
}

/**
 * P0b2: short-lived POS cart reservation, not a sale, refund, payment,
 * till movement or physical handover. Uses the same Reservation rows as
 * online orders, with claimType=pos_draft and immutable line identity.
 */
model PosStockHold {
  id String @id @default(uuid())
  tillSessionId String
  till CashierTillSession @relation(fields: [tillSessionId], references: [id], onUpdate: NoAction)
  locationId String
  createdByUserId String
  status String @default("held")
  subtotalMinor Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  releaseNote String?
  lines PosStockHoldLine[]
  cashSale PosCashSale?
  @@index([tillSessionId, status, expiresAt], map: "pos_holds_by_till")
  @@index([locationId, createdAt], map: "pos_holds_by_location")
  // Existing UAT database relationships; no database change.
  User            User               @relation(fields: [createdByUserId], references: [id], onUpdate: NoAction)
  Location        Location           @relation(fields: [locationId], references: [id], onUpdate: NoAction)
}

model PosStockHoldLine {
  id String @id @default(uuid())
  holdId String
  hold PosStockHold @relation(fields: [holdId], references: [id], onUpdate: NoAction)
  variantId String
  quantity Decimal @db.Decimal(15,3)
  unitPriceMinor Int
  lineTotalMinor Int
  @@unique([holdId, variantId], map: "pos_hold_line_unique")
  // Existing UAT database relationships; no database change.
  Variant            Variant             @relation(fields: [variantId], references: [id], onUpdate: NoAction)
  posCashReceiptLine PosCashReceiptLine?
}

/**
 * P0c1: immutable, physically counted CASH sale and handover against an
 * existing POS reservation. No electronic payment claims or tax invoices.
 * Once inserted, consumed stock and recorded cash cannot be silently undone.
 */
model PosCashSale {
  id String @id @default(uuid())
  reference String @unique
  holdId String @unique
  hold PosStockHold @relation(fields: [holdId], references: [id], onUpdate: NoAction)
  tillSessionId String
  till CashierTillSession @relation(fields: [tillSessionId], references: [id], onUpdate: NoAction)
  locationId String
  soldByUserId String
  stockDepletionId String @unique
  depletion StockDepletion @relation(fields: [stockDepletionId], references: [id], onUpdate: NoAction)
  // Immutable sale-time customer identity. Named walk-ins are NOT user accounts.
  customerMode String @default("walk_in")
  customerUserId String?
  customerUser User? @relation("PosSaleRegisteredCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  customerName String @default("Walk-in Customer")
  customerPhone String?
  subtotalMinor Int
  cashReceivedMinor Int
  changeGivenMinor Int
  handoverNote String
  cashCountConfirmed Boolean
  goodsHandedOver Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  receiptLines PosCashReceiptLine[]
  @@index([tillSessionId, createdAt], map: "pos_cash_by_till")
  @@index([locationId, createdAt], map: "pos_cash_by_location")
  @@index([customerUserId, createdAt])
  // Existing UAT database relationships; no database change.
  Location                            Location             @relation(fields: [locationId], references: [id], onUpdate: NoAction)
  User_PosCashSale_soldByUserIdToUser User                 @relation("PosCashSale_soldByUserIdToUser", fields: [soldByUserId], references: [id], onUpdate: NoAction)
}


/** Append-only product identity snapshot for reprinted physical cash receipts. */
model PosCashReceiptLine {
  id String @id @default(uuid())
  saleId String
  sale PosCashSale @relation(fields: [saleId], references: [id], onUpdate: NoAction)
  holdLineId String @unique
  variantId String
  productName String
  variantName String
  unit String
  quantity Decimal @db.Decimal(15,3)
  unitPriceMinor Int
  lineTotalMinor Int
  @@index([saleId, variantId], map: "pos_receipt_sale_variant")
  // Existing UAT database relationships; no database change.
  PosStockHoldLine PosStockHoldLine @relation(fields: [holdLineId], references: [id], onUpdate: NoAction)
  Variant          Variant          @relation(fields: [variantId], references: [id], onUpdate: NoAction)
}


/**
 * Customer support requests from web chat, guest checkout or help centre.
 * Only an authenticated administrator may list or change case status.
 * No message is sent or telephone call initiated by storing a case.
 */
model CustomerSupportCase {
  id String @id @default(uuid())
  reference String @unique
  name String
  phone String
  email String?
  subject String
  message String
  orderReference String?
  preferredContact String @default("phone")
  status String @default("open")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  activities CustomerSupportActivity[]
  @@index([status, createdAt])
  @@index([createdAt])
}

model CustomerSupportActivity {
  id String @id @default(uuid())
  caseId String
  supportCase CustomerSupportCase @relation(fields: [caseId], references: [id])
  actorId String?
  action String
  privateNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([caseId, createdAt])
}

/// One-time phone challenge. OTP secrets are HMAC digests, never plaintext.
/// Phone destinations are encrypted at rest; fingerprint supports rate limits.
model CustomerOtpChallenge {
  id String @id @default(uuid())
  userId String
  purpose String
  recipientFingerprint String
  recipientEncrypted String
  codeDigest String
  status String @default("pending")
  attempts Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
  @@index([recipientFingerprint, purpose, createdAt])
  @@index([status, expiresAt])
}

/// Administrator-managed public business identity. Financial and runtime policy
/// remains under its existing authority.
model BusinessProfile {
  id String @id
  businessName String
  supportPhone String
  supportEmail String
  address String
  registrationNumber String
  operatingHours String
  receiptFooter String
  version Int @default(1)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
}

/// Manual partner directory only; it cannot enable external API dispatch.
model DeliveryPartner {
  id String @id @default(uuid())
  name String
  contactPhone String
  contactEmail String
  coverage String
  notes String
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
}

/// Encrypted credential candidate, never read by the active runtime adapters.
model IntegrationCredentialDraft {
  id String @id
  ciphertext String
  version Int @default(1)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamptz(3)
}


// Internal transfer requisitions are not supplier purchase orders or stock receipts.
// Authorization alone does not reserve, dispatch or post inventory.
model InternalTransferRequest {
  id String @id @default(uuid())
  destinationId String
  destination Location @relation("TransferDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  sourceId String?
  source Location? @relation("TransferSource", fields: [sourceId], references: [id], onDelete: Restrict)
  requestedBy String
  requestKey String
  requestHash String
  note String
  status String @default("requested")
  version Int @default(1)
  decidedBy String?
  decisionNote String?
  decidedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines InternalTransferRequestLine[]
  @@unique([requestedBy, requestKey])
  @@index([destinationId, status, createdAt])
  @@index([sourceId, status, createdAt])
}

model InternalTransferRequestLine {
  id String @id @default(uuid())
  requestId String
  request InternalTransferRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  variantId String
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Decimal @db.Decimal(15, 3)
  @@unique([requestId, variantId])
}
