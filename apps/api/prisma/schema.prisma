generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  inventory_manager
  customer
  rider
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
  locations UserLocation[]
  customerAddresses CustomerAddress[]
  orders Order[]
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  channel String
  tokenHash String? @unique
  csrfHash String?
  accessHash String? @unique
  accessExpiresAt DateTime? @db.Timestamptz(3)
  currentRefreshHash String? @unique
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  refreshHistory RefreshToken[]
  @@index([userId, expiresAt])
}

model RefreshToken {
  hash String @id
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  usedAt DateTime? @db.Timestamptz(3)
}

model LoginThrottle {
  key String @id
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
}

model Location {
  id String @id
  name String
  active Boolean @default(true)
  grants UserLocation[]
  positions StockPosition[]
}

model UserLocation {
  userId String
  user User @relation(fields: [userId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  @@id([userId, locationId])
}

model Category {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String @default("")
  tint String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  products Product[]
}

model Product {
  id String @id @default(uuid())
  slug String @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  description String @default("")
  shortDescription String @default("")
  image String @default("")
  tags String[]
  published Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  variants Variant[]
  @@index([categoryId, published])
}

model Variant {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  name String
  unit String
  unitSize String @default("1")
  priceMinor Int
  compareAtPriceMinor Int?
  barcode String? @unique
  active Boolean @default(true)
  positions StockPosition[]
  @@index([productId, active])
}

model StockPosition {
  id String @id @default(uuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  safetyStock Decimal @default(0) @db.Decimal(15, 3)
  lots StockLot[]
  reservations Reservation[]
  @@unique([variantId, locationId])
}

model StockLot {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  receiptId String?
  receipt StockReceipt? @relation(fields: [receiptId], references: [id])
  lotNumber String
  quantity Decimal @db.Decimal(15, 3)
  expiryDate DateTime? @db.Date
  quarantined Boolean @default(false)
  kind String @default("regular")
  unitCostMinor Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  movements StockMovement[]
  reservations Reservation[]
  @@unique([id, positionId])
  @@index([positionId, kind, quarantined, expiryDate])
}

model Reservation {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  lotId String
  lot StockLot @relation(fields: [lotId, positionId], references: [id, positionId])
  claimType String
  claimId String
  claimLineId String
  generation Int @default(1)
  quantity Decimal @db.Decimal(15, 3)
  state String @default("active")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([claimType, claimId, claimLineId, lotId, generation])
  @@index([positionId, state, expiresAt])
  @@index([lotId, state, expiresAt])
  @@index([claimType, claimId, state])
}

model StockReceipt {
  id String @id @default(uuid())
  receivedBy String
  note String?
  poRef String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lots StockLot[]
  movements StockMovement[]
}

model StockMovement {
  id String @id @default(uuid())
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  receiptId String
  receipt StockReceipt @relation(fields: [receiptId], references: [id])
  delta Decimal @db.Decimal(15, 3)
  resultingQty Decimal @db.Decimal(15, 3)
  actorId String
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([lotId, createdAt])
}

model Idempotency {
  actorId String
  operation String
  key String
  requestHash String
  outcome Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorId, operation, key])
}

model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  entityId String
  requestId String
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([entityId, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid())
  type String
  aggregateId String
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  @@index([publishedAt, createdAt])
}

model GuestCheckoutSession {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfHash String
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  orders Order[]
  @@index([expiresAt, revokedAt])
}

model CustomerAddress {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  label String
  recipientName String
  phone String
  locality String
  street String
  landmark String?
  ghanaPostGps String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([userId, isDefault])
}

model DeliveryZone {
  id String @id
  name String
  areas String[]
  active Boolean @default(true)
  feeMinor Int
  minimumOrderMinor Int
  serviceHours String
  cutoff String
  slotsPerDay Int
  slotPolicy String @default("required")
  codEnabled Boolean @default(false)
  slots DeliverySlot[]
  orders Order[]
  @@index([active, name])
}

model DeliverySlot {
  id String @id
  zoneId String
  zone DeliveryZone @relation(fields: [zoneId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  capacity Int
  active Boolean @default(true)
  bookings DeliverySlotBooking[]
  orders Order[]
  @@index([zoneId, active, startsAt])
}

model Order {
  id String @id @default(uuid())
  reference String @unique
  channel String @default("online")
  customerUserId String?
  customerUser User? @relation(fields: [customerUserId], references: [id])
  guestSessionId String?
  guestSession GuestCheckoutSession? @relation(fields: [guestSessionId], references: [id])
  customerName String
  customerPhone String
  customerEmail String?
  fulfilment String
  zoneId String?
  zone DeliveryZone? @relation(fields: [zoneId], references: [id])
  slotId String?
  slot DeliverySlot? @relation(fields: [slotId], references: [id])
  paymentMethod String
  paymentStatus String
  fulfilmentStatus String
  deliveryStatus String
  subtotalMinor Int
  discountMinor Int @default(0)
  deliveryFeeMinor Int @default(0)
  totalMinor Int
  verificationKeyVersion Int
  verificationCodeHash String
  version Int @default(1)
  note String?
  stockConsumedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelledReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lines OrderLine[]
  events OrderEvent[]
  deliveryAddress OrderDeliveryAddress?
  slotBooking DeliverySlotBooking?
  paymentAttempts PaymentAttempt[]
  @@index([customerUserId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([zoneId, createdAt])
  @@index([slotId, createdAt])
}

model OrderDeliveryAddress {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id])
  label String
  recipientName String
  phone String
  locality String
  street String
  landmark String?
  ghanaPostGps String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model OrderLine {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  variantId String
  productId String
  productName String
  variantName String
  unit String
  quantity Decimal @db.Decimal(15, 3)
  unitPriceMinor Int
  lineTotalMinor Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, id])
  @@index([variantId])
}

model OrderEvent {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  actorKind String
  actorId String?
  action String
  fromStatus String?
  toStatus String?
  note String?
  customerSafe Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model DeliverySlotBooking {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  slotId String
  slot DeliverySlot @relation(fields: [slotId], references: [id])
  state String @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  @@index([slotId, state])
}

model TrackingThrottle {
  key String @id
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
}

model PaymentAttempt {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  provider String
  method String
  currency String @default("GHS")
  amountMinor Int
  merchantReference String @unique
  providerRef String?
  status String @default("initiated")
  initiationState String @default("created")
  settlementState String @default("unsettled")
  callbackCount Int @default(0)
  failureCode String?
  failureReason String?
  providerExpiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  providerEvents PaymentProviderEvent[]
  reconciliations PaymentReconciliation[]
  @@unique([provider, providerRef])
  @@index([orderId, createdAt])
  @@index([status, settlementState, createdAt])
}

model PaymentProviderEvent {
  id String @id @default(uuid())
  provider String
  providerEventId String?
  dedupeKey String
  paymentAttemptId String?
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  providerRef String?
  rawBodyHash String
  verificationResult String
  observedState String?
  observedAmountMinor Int?
  observedCurrency String?
  providerTimestamp DateTime? @db.Timestamptz(3)
  processingResult String?
  safeMetadata Json
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  @@unique([provider, providerEventId])
  @@unique([provider, dedupeKey])
  @@index([paymentAttemptId, receivedAt])
  @@index([provider, processingResult, receivedAt])
}

model PaymentReconciliation {
  id String @id @default(uuid())
  paymentAttemptId String
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  provider String
  trigger String
  observedState String
  providerRef String?
  observedAmountMinor Int?
  observedCurrency String?
  result String
  safeNote String?
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([paymentAttemptId, createdAt])
  @@index([provider, result, createdAt])
}
