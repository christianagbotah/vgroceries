generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  inventory_manager
  customer
  rider
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
  locations UserLocation[]
  customerAddresses CustomerAddress[]
  orders Order[]
  riderProfile RiderProfile?
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  channel String
  tokenHash String? @unique
  csrfHash String?
  accessHash String? @unique
  accessExpiresAt DateTime? @db.Timestamptz(3)
  currentRefreshHash String? @unique
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  refreshHistory RefreshToken[]
  @@index([userId, expiresAt])
}

model RefreshToken {
  hash String @id
  sessionId String
  session Session @relation(fields: [sessionId], references: [id])
  usedAt DateTime? @db.Timestamptz(3)
}

model LoginThrottle {
  key String @id
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
}

model Location {
  id String @id
  name String
  active Boolean @default(true)
  grants UserLocation[]
  positions StockPosition[]
  logisticsNode LogisticsNode?
}

model UserLocation {
  userId String
  user User @relation(fields: [userId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  @@id([userId, locationId])
}

model Category {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String @default("")
  tint String?
  active Boolean @default(true)
  sortOrder Int @default(0)
  products Product[]
}

model Product {
  id String @id @default(uuid())
  slug String @unique
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  description String @default("")
  shortDescription String @default("")
  image String @default("")
  tags String[]
  published Boolean @default(false)
  brandMode String @default("auto")
  featuredMediaId String? @unique
  featuredMedia ProductMedia? @relation("ProductFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  media ProductMedia[] @relation("ProductMediaCollection")
  generationJobs ImageGenerationJob[] @relation("ProductGenerationJobs")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  variants Variant[]
  @@index([categoryId, published])
}

model ProductMedia {
  id String @id @default(uuid())
  productId String
  product Product @relation("ProductMediaCollection", fields: [productId], references: [id], onDelete: Restrict)
  source String
  status String @default("draft")
  storageKey String @unique
  publicUrl String?
  mimeType String
  width Int
  height Int
  byteSize Int
  sha256 String
  altText String @default("")
  galleryOrder Int?
  originalFilename String?
  generationJobId String?
  generationJob ImageGenerationJob? @relation("GenerationCandidates", fields: [generationJobId], references: [id], onDelete: SetNull)
  referenceForJobs ImageGenerationJob[] @relation("GenerationReferenceMedia")
  createdBy String
  approvedBy String?
  approvedAt DateTime? @db.Timestamptz(3)
  rejectedAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  featuredFor Product? @relation("ProductFeaturedMedia")
  @@index([productId, status, galleryOrder])
  @@index([generationJobId])
  @@index([sha256])
}

model ImageGenerationJob {
  id String @id @default(uuid())
  productId String
  product Product @relation("ProductGenerationJobs", fields: [productId], references: [id], onDelete: Restrict)
  requestedBy String
  mode String
  stylePreset String
  status String @default("queued")
  provider String
  model String
  prompt String
  requestSnapshot Json
  referenceMediaId String?
  referenceMedia ProductMedia? @relation("GenerationReferenceMedia", fields: [referenceMediaId], references: [id], onDelete: Restrict)
  candidateCount Int
  providerRequestId String?
  attemptCount Int @default(0)
  errorCode String?
  errorMessage String?
  startedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  candidates ProductMedia[] @relation("GenerationCandidates")
  @@index([productId, createdAt])
  @@index([status, createdAt])
}

model Variant {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  name String
  unit String
  unitSize String @default("1")
  priceMinor Int
  compareAtPriceMinor Int?
  barcode String? @unique
  active Boolean @default(true)
  positions StockPosition[]
  @@index([productId, active])
}

model StockPosition {
  id String @id @default(uuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  safetyStock Decimal @default(0) @db.Decimal(15, 3)
  lots StockLot[]
  reservations Reservation[]
  @@unique([variantId, locationId])
}

model StockLot {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  receiptId String?
  receipt StockReceipt? @relation(fields: [receiptId], references: [id])
  lotNumber String
  quantity Decimal @db.Decimal(15, 3)
  expiryDate DateTime? @db.Date
  quarantined Boolean @default(false)
  kind String @default("regular")
  unitCostMinor Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  movements StockMovement[]
  reservations Reservation[]
  fulfilmentPicks FulfilmentPick[]
  depletionLines StockDepletionLine[]
  @@unique([id, positionId])
  @@index([positionId, kind, quarantined, expiryDate])
}

model Reservation {
  id String @id @default(uuid())
  positionId String
  position StockPosition @relation(fields: [positionId], references: [id])
  lotId String
  lot StockLot @relation(fields: [lotId, positionId], references: [id, positionId])
  claimType String
  claimId String
  claimLineId String
  generation Int @default(1)
  quantity Decimal @db.Decimal(15, 3)
  state String @default("active")
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  fulfilmentPick FulfilmentPick?
  depletionLine StockDepletionLine?
  @@unique([claimType, claimId, claimLineId, lotId, generation])
  @@index([positionId, state, expiresAt])
  @@index([lotId, state, expiresAt])
  @@index([claimType, claimId, state])
}

model StockReceipt {
  id String @id @default(uuid())
  receivedBy String
  note String?
  poRef String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lots StockLot[]
  movements StockMovement[]
}

model StockMovement {
  id String @id @default(uuid())
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  receiptId String
  receipt StockReceipt @relation(fields: [receiptId], references: [id])
  delta Decimal @db.Decimal(15, 3)
  resultingQty Decimal @db.Decimal(15, 3)
  actorId String
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([lotId, createdAt])
}

model Idempotency {
  actorId String
  operation String
  key String
  requestHash String
  outcome Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorId, operation, key])
}

model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  entityId String
  requestId String
  details Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([entityId, createdAt])
}

model OutboxEvent {
  id String @id @default(uuid())
  type String
  aggregateId String
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  @@index([publishedAt, createdAt])
}

model GuestCheckoutSession {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfHash String
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  orders Order[]
  @@index([expiresAt, revokedAt])
}

model CustomerAddress {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  label String
  recipientName String
  phone String
  locality String
  street String
  landmark String?
  ghanaPostGps String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([userId, isDefault])
}

model DeliveryZone {
  id String @id
  name String
  areas String[]
  active Boolean @default(true)
  feeMinor Int
  minimumOrderMinor Int
  serviceHours String
  cutoff String
  slotsPerDay Int
  slotPolicy String @default("required")
  codEnabled Boolean @default(false)
  slots DeliverySlot[]
  orders Order[]
  routeRules DeliveryRouteRule[]
  @@index([active, name])
}

model DeliverySlot {
  id String @id
  zoneId String
  zone DeliveryZone @relation(fields: [zoneId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  capacity Int
  active Boolean @default(true)
  bookings DeliverySlotBooking[]
  orders Order[]
  @@index([zoneId, active, startsAt])
}

model Order {
  id String @id @default(uuid())
  reference String @unique
  channel String @default("online")
  customerUserId String?
  customerUser User? @relation(fields: [customerUserId], references: [id])
  guestSessionId String?
  guestSession GuestCheckoutSession? @relation(fields: [guestSessionId], references: [id])
  customerName String
  customerPhone String
  customerEmail String?
  fulfilment String
  zoneId String?
  zone DeliveryZone? @relation(fields: [zoneId], references: [id])
  slotId String?
  slot DeliverySlot? @relation(fields: [slotId], references: [id])
  paymentMethod String
  paymentStatus String
  fulfilmentStatus String
  deliveryStatus String
  subtotalMinor Int
  discountMinor Int @default(0)
  deliveryFeeMinor Int @default(0)
  totalMinor Int
  verificationKeyVersion Int
  verificationCodeHash String
  version Int @default(1)
  note String?
  stockConsumedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelledReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lines OrderLine[]
  events OrderEvent[]
  deliveryAddress OrderDeliveryAddress?
  slotBooking DeliverySlotBooking?
  paymentAttempts PaymentAttempt[]
  refunds Refund[]
  fulfilmentRun FulfilmentRun?
  deliveryJob DeliveryJob?
  deliveryEvents DeliveryEvent[]
  @@index([customerUserId, createdAt])
  @@index([guestSessionId, createdAt])
  @@index([zoneId, createdAt])
  @@index([slotId, createdAt])
}

model OrderDeliveryAddress {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id])
  label String
  recipientName String
  phone String
  locality String
  street String
  landmark String?
  ghanaPostGps String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model OrderLine {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  variantId String
  productId String
  productName String
  variantName String
  unit String
  quantity Decimal @db.Decimal(15, 3)
  unitPriceMinor Int
  lineTotalMinor Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, id])
  @@index([variantId])
}

model OrderEvent {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  actorKind String
  actorId String?
  action String
  fromStatus String?
  toStatus String?
  note String?
  customerSafe Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId, createdAt])
}

model DeliverySlotBooking {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  slotId String
  slot DeliverySlot @relation(fields: [slotId], references: [id])
  state String @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  @@index([slotId, state])
}

model TrackingThrottle {
  key String @id
  windowStart DateTime @db.Timestamptz(3)
  attempts Int
}

model PaymentAttempt {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  provider String
  method String
  currency String @default("GHS")
  amountMinor Int
  merchantReference String @unique
  providerRef String?
  status String @default("initiated")
  initiationState String @default("created")
  settlementState String @default("unsettled")
  callbackCount Int @default(0)
  failureCode String?
  failureReason String?
  providerExpiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  providerEvents PaymentProviderEvent[]
  reconciliations PaymentReconciliation[]
  refunds Refund[]
  @@unique([provider, providerRef])
  @@index([orderId, createdAt])
  @@index([status, settlementState, createdAt])
}

model PaymentProviderEvent {
  id String @id @default(uuid())
  provider String
  providerEventId String?
  dedupeKey String
  paymentAttemptId String?
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
  providerRef String?
  rawBodyHash String
  verificationResult String
  observedState String?
  observedAmountMinor Int?
  observedCurrency String?
  providerTimestamp DateTime? @db.Timestamptz(3)
  processingResult String?
  safeMetadata Json
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  @@unique([provider, providerEventId])
  @@unique([provider, dedupeKey])
  @@index([paymentAttemptId, receivedAt])
  @@index([provider, processingResult, receivedAt])
}

model PaymentReconciliation {
  id String @id @default(uuid())
  paymentAttemptId String
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  provider String
  trigger String
  observedState String
  providerRef String?
  observedAmountMinor Int?
  observedCurrency String?
  result String
  safeNote String?
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([paymentAttemptId, createdAt])
  @@index([provider, result, createdAt])
}

model Refund {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  paymentAttemptId String
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  provider String
  method String
  currency String @default("GHS")
  amountMinor Int
  sourceType String
  returnId String?
  reason String
  status String @default("awaiting_approval")
  requestedBy String
  approvedBy String?
  approvedAt DateTime? @db.Timestamptz(3)
  failureReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  execution RefundExecution?
  reconciliations RefundReconciliation[]
  @@index([orderId, createdAt])
  @@index([paymentAttemptId, createdAt])
  @@index([status, createdAt])
}

model RefundExecution {
  id String @id @default(uuid())
  refundId String @unique
  refund Refund @relation(fields: [refundId], references: [id])
  provider String
  method String
  currency String @default("GHS")
  amountMinor Int
  merchantRefundReference String @unique
  originalPaymentMerchantReference String
  originalPaymentProviderReference String?
  providerRefundReference String?
  status String @default("created")
  reconciliationState String @default("unreconciled")
  attemptCount Int @default(0)
  failureCode String?
  failureReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  reconciliations RefundReconciliation[]
  @@unique([provider, providerRefundReference])
  @@index([status, reconciliationState, createdAt])
}

model RefundReconciliation {
  id String @id @default(uuid())
  refundId String
  refund Refund @relation(fields: [refundId], references: [id])
  refundExecutionId String
  refundExecution RefundExecution @relation(fields: [refundExecutionId], references: [id])
  provider String
  trigger String
  observedState String
  providerRefundReference String?
  observedAmountMinor Int?
  observedCurrency String?
  result String
  safeNote String?
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([refundExecutionId, createdAt])
  @@index([refundId, createdAt])
  @@index([provider, result, createdAt])
}

model FulfilmentRun {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  locationId String
  confirmedBy String?
  confirmedAt DateTime? @db.Timestamptz(3)
  pickingStartedBy String?
  pickingStartedAt DateTime? @db.Timestamptz(3)
  packedBy String?
  packedAt DateTime? @db.Timestamptz(3)
  packNote String?
  handedOverBy String?
  handedOverAt DateTime? @db.Timestamptz(3)
  handoverKind String?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  picks FulfilmentPick[]
  @@index([locationId, createdAt])
}

model FulfilmentPick {
  id String @id @default(uuid())
  fulfilmentRunId String
  fulfilmentRun FulfilmentRun @relation(fields: [fulfilmentRunId], references: [id])
  orderId String
  orderLineId String
  reservationId String @unique
  reservation Reservation @relation(fields: [reservationId], references: [id])
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  variantId String
  quantity Decimal @db.Decimal(15, 3)
  pickedQuantity Decimal @db.Decimal(15, 3)
  state String
  note String?
  recordedBy String
  recordedAt DateTime @db.Timestamptz(3)
  version Int @default(1)
  @@index([fulfilmentRunId, state])
  @@index([orderId, recordedAt])
}

model StockDepletion {
  id String @id @default(uuid())
  claimType String
  claimId String
  locationId String
  kind String
  actorId String
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines StockDepletionLine[]
  @@unique([claimType, claimId])
  @@index([locationId, createdAt])
}

model StockDepletionLine {
  id String @id @default(uuid())
  depletionId String
  depletion StockDepletion @relation(fields: [depletionId], references: [id])
  reservationId String @unique
  reservation Reservation @relation(fields: [reservationId], references: [id])
  claimLineId String
  variantId String
  lotId String
  lot StockLot @relation(fields: [lotId], references: [id])
  quantity Decimal @db.Decimal(15, 3)
  lotQuantityBefore Decimal @db.Decimal(15, 3)
  lotQuantityAfter Decimal @db.Decimal(15, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([depletionId, id])
  @@index([lotId, createdAt])
}


model RiderProfile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  phone String
  kind String
  vehicle String
  availabilityState String @default("offline")
  lastAvailabilityChangedAt DateTime @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  jobs DeliveryJob[]
  @@index([availabilityState, updatedAt])
}

model DeliveryJob {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  assignmentKind String
  riderProfileId String?
  riderProfile RiderProfile? @relation(fields: [riderProfileId], references: [id])
  providerKey String?
  providerNameSnapshot String?
  manualProviderReference String?
  status String
  custodyState String
  assignedBy String
  assignedAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  pickedUpAt DateTime? @db.Timestamptz(3)
  outForDeliveryAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  failedAt DateTime? @db.Timestamptz(3)
  failureReasonCode String?
  failureNote String?
  rescheduledFor DateTime? @db.Timestamptz(3)
  returnedToStoreAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  events DeliveryEvent[]
  proof DeliveryProof?
  @@index([status, updatedAt])
  @@index([riderProfileId, status, updatedAt])
}

model DeliveryEvent {
  id String @id @default(uuid())
  deliveryJobId String
  deliveryJob DeliveryJob @relation(fields: [deliveryJobId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  actorKind String
  actorId String?
  action String
  fromStatus String?
  toStatus String?
  note String?
  safeMetadata Json
  requestId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([deliveryJobId, createdAt])
  @@index([orderId, createdAt])
}

model DeliveryProof {
  id String @id @default(uuid())
  deliveryJobId String @unique
  deliveryJob DeliveryJob @relation(fields: [deliveryJobId], references: [id])
  method String
  reference String?
  note String?
  recordedByKind String
  recordedById String?
  recordedAt DateTime @db.Timestamptz(3)
}

model LogisticsNode {
  id String @id @default(uuid())
  code String @unique
  name String
  publicName String
  kind String
  kindLabel String?
  parentNodeId String?
  parent LogisticsNode? @relation("LogisticsNodeHierarchy", fields: [parentNodeId], references: [id], onDelete: Restrict)
  children LogisticsNode[] @relation("LogisticsNodeHierarchy")
  inventoryLocationId String? @unique
  inventoryLocation Location? @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  addressLine String?
  locality String?
  region String?
  ghanaPostGps String?
  publicDirections String?
  publicContact String?
  customerVisible Boolean @default(true)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  outgoingLanes LogisticsLane[] @relation("LogisticsLaneOrigin")
  incomingLanes LogisticsLane[] @relation("LogisticsLaneDestination")
  originRouteRules DeliveryRouteRule[] @relation("DeliveryRouteRuleOrigin")
  finalPickupRouteRules DeliveryRouteRule[] @relation("DeliveryRouteRuleFinalPickup")
  routeRuleStops DeliveryRouteRuleStop[]
  @@index([active, kind, name])
  @@index([parentNodeId])
}

model LogisticsLane {
  id String @id @default(uuid())
  originNodeId String
  originNode LogisticsNode @relation("LogisticsLaneOrigin", fields: [originNodeId], references: [id], onDelete: Restrict)
  destinationNodeId String
  destinationNode LogisticsNode @relation("LogisticsLaneDestination", fields: [destinationNodeId], references: [id], onDelete: Restrict)
  mode String
  providerKey String?
  typicalMinutes Int
  serviceDays Int[]
  cutoffLocalTime String?
  priority Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
